#!/bin/bash

if [[ $# -ne 1 || ( "$1" != "local" && "$1" != "hector" && "$1" != "asus" ) ]]; then
    echo "usage: deploy ( local | hector | asus )"
    exit 1
fi

ARG="$1"
SCRIPT="story-cli"
JAR="story-cli-assembly-0.1.0-SNAPSHOT.jar"
SRC_SCRIPT="src/scripts"
SRC_JAR="target/scala-3.9.0"
DST_SCRIPT="$HOME/bin/share/story-cli/$SRC_SCRIPT"
DST_JAR="$HOME/bin/share/story-cli/$SRC_JAR"

if [[ "$ARG" == "local"  ]]; then

    sbt clean    || exit 1
    sbt compile  || exit 1
    sbt assembly || exit 1

    if [[ ! -e "$DST_SCRIPT" ]]; then
        mkdir -p "$DST_SCRIPT"
    fi

    if [[ ! -e "$DST_JAR" ]]; then
        mkdir -p "$DST_JAR"
    fi

    cp "$SRC_SCRIPT/$SCRIPT" "$DST_SCRIPT"
    cp "$SRC_JAR/$JAR"       "$DST_JAR"

elif [[ "$ARG" == "hector" ]]; then

    # copy from already deployed local to remote
    # this makes it more likely that the local and remote are in sync

    scp "$DST_SCRIPT/$SCRIPT" hector:$DST_SCRIPT
    scp "$DST_JAR/$JAR"       hector:$DST_JAR

elif [[ "$ARG" == "asus" ]]; then

    # copy from already deployed local to remote
    # this makes it more likely that the local and remote are in sync

    scp "$DST_SCRIPT/$SCRIPT" asus:$DST_SCRIPT
    scp "$DST_JAR/$JAR"       asus:$DST_JAR

else
    echo "unexpected argument value: $ARG"
    exit 1
fi
