#!/bin/bash

# exit on error
set -e

if [[ $# -ne 1 || ( "$1" != "local" && "$1" != "hector" && "$1" != "asus" ) ]]; then
    echo "usage: deploy ( local | hector | asus )"
    exit 1
fi

ARG="$1"

SRC_SCRIPT_DIR="src/scripts"
SRC_JAR_DIR="target/out/jvm/scala-3.9.0/story-cli"
DST_DIR="$HOME/bin/share/story-cli"
DST_JAR_DIR="$DST_DIR/$SRC_JAR_DIR"
DST_SCRIPT_DIR="$DST_DIR/$SRC_SCRIPT_DIR"

SCRIPT="story-cli"
ALIAS="set-alias.sh"
MKDIRS="story-cli-mk-client-dirs.sh"
JAR="story-cli-assembly-0.1.0-SNAPSHOT.jar"

if [[ "$ARG" == "local"  ]]; then

    sbt clean
    sbt compile
    sbt assembly

    $SRC_SCRIPT_DIR/$MKDIRS

    cp "$SRC_SCRIPT_DIR/$SCRIPT" \
        "$SRC_SCRIPT_DIR/$ALIAS" \
        "$DST_SCRIPT_DIR"
    cp "$SRC_JAR_DIR/$JAR" "$DST_JAR_DIR"

elif [[ "$ARG" == "hector" || "$ARG" == "asus" ]]; then

    # copy from already deployed local to remote
    # this makes it more likely that the local and remote are in sync

    HOSTNAME="$ARG"

    # re-create remote directories
    scp "$SRC_SCRIPT_DIR/$MKDIRS" $HOSTNAME:.
    # run the script and remove it
    CMD="/bin/bash -c '\"$HOME/$MKDIRS\" && rm \"$HOME/$MKDIRS\"'"
    ssh $HOSTNAME "$CMD"

    scp "$DST_SCRIPT_DIR/$SCRIPT" \
        "$DST_SCRIPT_DIR/$ALIAS" \
        $HOSTNAME:"$DST_SCRIPT_DIR"
    scp "$DST_JAR_DIR/$JAR" $HOSTNAME:$DST_JAR_DIR

else
    echo "unexpected argument value: $ARG"
    exit 1
fi
